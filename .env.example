# FindFood mobile: environment variables (template, committed).
#
# Profiles, selected with EXPO_PUBLIC_APP_ENV:
#   real   Real API + Supabase. Copy this file to .env.local (git-ignored, loaded in
#          every mode) and fill it in. Do not copy it to .env: .env is not git-ignored.
#   local  findfood-api running on your machine, development builds only. Do not edit
#          by hand: `npm run start:local -- [donante|voluntario]` generates
#          .env.development.local (higher priority than .env.local, development only).
#          `npm run start:real` removes it again.
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle and anyone with the app
# can read them. Only public values belong here (URLs, anon key, OAuth client IDs).
#
# WARNING: never set EXPO_PUBLIC_DEV_TOKEN in .env, .env.local or EAS environment
# variables. It is a development-only credential; only the generated
# .env.development.local may contain it, and the app ignores it outside __DEV__.

# Profile: "real" (default when unset) or "local" (development only).
EXPO_PUBLIC_APP_ENV=real

# findfood-api base URL, without trailing slash and without /v1. Required.
EXPO_PUBLIC_API_URL=https://api.example.com

# Supabase project URL and anon (public) key. Required by the real profile.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client IDs for native sign-in. Optional until Google sign-in is set up.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Generated by `npm run start:local`; listed for reference only. Never set it here.
# EXPO_PUBLIC_DEV_TOKEN=

# Options for scripts/dev-env.mjs, read from your shell (not by the app):
# FINDFOOD_API_DIR=../findfood-api   folder of findfood-api
# DEV_API_HOST=192.168.1.10          API host the phone uses (default: first LAN IPv4)
# DEV_API_PORT=3000                  API port
# DEV_TOKEN_TTL_HOURS=24             dev token lifetime in hours

# Build-time only (read by app.config.ts, never inlined into the bundle). Set them in
# .env.local for local native builds and as EAS environment variables (visibility
# "sensitive") for EAS builds. A new native build is needed after changing any of them.
#
# Google Maps SDK keys, restricted in Google Cloud to the platform and to co.findfood.app.
# Without them the react-native-maps plugin is not added and Google maps do not load.
# Android only: also restrict the key to the SHA-1 of each keystore. The app ships no iOS build.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# EAS project id (expo.dev → project → ID). Only needed when `eas init` has not written
# extra.eas.projectId to app.json; expo-notifications needs it for push tokens.
EAS_PROJECT_ID=
