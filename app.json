{
  "expo": {
    "name": "Find Food",
    "slug": "findfood-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/findfood-logo.png",
    "scheme": "findfoodappmobile",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF8",
        "foregroundImage": "./assets/brand/findfood-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/findfood-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF8",
          "image": "./assets/brand/findfood-logo.png",
          "imageWidth": 100
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
