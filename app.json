{
  "expo": {
    "name": "Find Food",
    "slug": "findfood-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/findfood-logo.png",
    "scheme": "findfoodappmobile",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "co.findfood.app"
    },
    "android": {
      "package": "co.findfood.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF8",
        "foregroundImage": "./assets/brand/findfood-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/findfood-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF8",
          "image": "./assets/brand/findfood-logo.png",
          "imageWidth": 100
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Find Food usa la cámara para tomar las fotos de evidencia de tus donaciones y entregas.",
          "photosPermission": "Find Food accede a tus fotos para que elijas la evidencia de tus donaciones y entregas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F7A5A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find Food usa tu ubicación para mostrarte en el mapa y elegir puntos de recogida.",
          "locationAlwaysAndWhenInUsePermission": "Find Food usa tu ubicación, también en segundo plano, para ofrecerte donaciones cercanas mientras estás disponible como voluntario.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc1ca636-d9d3-4c38-b0a8-a8c090e3473a"
      }
    },
    "owner": "findfood-group"
  }
}
